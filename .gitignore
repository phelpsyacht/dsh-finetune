# ---------------------------------------------------------------------------
# dsh-finetune .gitignore
# ---------------------------------------------------------------------------

# Node / dependencies
node_modules/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Local artifacts
chats/
models/
charts/
runs/

# Generated dataset artifacts (written next to the input dataset)
*.clean.jsonl
*.clean.python-report.json
*.quarantine.jsonl
*.quarantine.csv
*.quarantine.html

# Model weights / adapters saved by local training
*.safetensors
*.gguf
*.pt
*.pth
*.ckpt

# Secrets / local config (provider API keys)
.env
.env.*

# OS / logs
.DS_Store
*.log
